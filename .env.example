[TEMPLATE]
# آدرس پنل (کلاینت React/Vite) برای دکمه‌های ورود و ثبت‌نام
# در Docker این مقدار در زمان بیلد داخل باندل قرار می‌گیرد.
# توسعه محلی Vite: http://localhost:5173
# استقرار Docker: آدرس عمومی پنل، مثلاً https://app.example.com
NEXT_PUBLIC_APP_URL=http://localhost:5173

# --- فقط برای docker compose ---
# پورت انتشار لندینگ روی هاست
LANDING_PORT=3000
# برای قرار گرفتن پشت reverse proxy، 127.0.0.1 بگذارید
LANDING_BIND=0.0.0.0
